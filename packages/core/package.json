{
  "name": "@rebyte/agent-sdk",
  "version": "0.1.0",
  "description": "Framework-free TypeScript SDK for Rebyte Agents and the Responses API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReByteAI/rebyte-agent-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ReByteAI/rebyte-agent-sdk#readme",
  "bugs": "https://github.com/ReByteAI/rebyte-agent-sdk/issues",
  "engines": { "node": ">=22" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
