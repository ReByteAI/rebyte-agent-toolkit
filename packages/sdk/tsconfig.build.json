{
  "extends": "./tsconfig.json",
  "include": [
    "dist/src"
  ],
  "exclude": [],
  "compilerOptions": {
    "rootDir": "./dist/src",
    "paths": {
      "@rebyteai/agent-sdk/*": [
        "./dist/src/*"
      ],
      "@rebyteai/agent-sdk": [
        "./dist/src/index.ts"
      ]
    },
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "pretty": true,
    "sourceMap": true
  }
}
