{
  "name": "rebyte-agent-toolkit",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReByteAI/rebyte-agent-toolkit.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @rebyte/example-react-chat dev",
    "pack:release": "node scripts/pack-release.mjs",
    "test": "pnpm --filter @rebyte/cli build && pnpm --filter @rebyte/cli smoke",
    "test:live": "pnpm build && pnpm --filter @rebyte/example-react-chat test:live",
    "typecheck": "pnpm --filter @rebyte/agent-react build && pnpm --filter @rebyte/agent-ui build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
